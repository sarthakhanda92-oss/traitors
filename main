<script>

/*
==========================================================
TRAITORS GAME SIMULATOR
==========================================================

START:

21 players
3 traitors
18 faithfuls


NORMAL ROUND:

1. Voting elimination
   Everyone votes.

2. Murder
   Only traitors choose a victim.
   Victim must be faithful.


RECRUITMENT:

If exactly two traitors remain:

    2 traitors
        ↓
    recruit 1 faithful
        ↓
    3 traitors

Recruitment can happen once.


ENDGAME:

When 3 players remain:

    3 players
        ↓
    voting
        ↓
    2 players
        ↓
    voting
        ↓
    1 player

Final player's role determines winner.

==========================================================
*/


let isRunning = false;

let stopRequested = false;


/*
----------------------------------------------------------
UTILITY FUNCTIONS
----------------------------------------------------------
*/


function randomElement(array) {

    return array[
        Math.floor(
            Math.random() * array.length
        )
    ];

}


/*
----------------------------------------------------------
SHUFFLE
----------------------------------------------------------
*/


function shuffle(array) {

    const result = [...array];

    for (
        let i = result.length - 1;
        i > 0;
        i--
    ) {

        const j =
            Math.floor(
                Math.random() * (i + 1)
            );

        [
            result[i],
            result[j]
        ] =
        [
            result[j],
            result[i]
        ];

    }

    return result;

}


/*
----------------------------------------------------------
CREATE ONE GAME
----------------------------------------------------------
*/


function simulateGame() {

    /*
    Players are represented by numbers:

    0 ... 20
    */

    let players =
        Array.from(
            { length: 21 },
            (_, i) => i
        );


    /*
    Randomly select 3 starting traitors.
    */

    const shuffled =
        shuffle(players);

    let traitors =
        new Set(
            shuffled.slice(0, 3)
        );


    /*
    Recruitment may happen only once.
    */

    let recruitmentUsed = false;


    let normalRounds = 0;


    /*
    ======================================================
    NORMAL GAME
    ======================================================
    */

    while (players.length > 3) {

        normalRounds++;


        /*
        ==================================================
        1. VOTING ELIMINATION
        ==================================================

        EVERYONE votes.

        Traitors vote.
        Faithfuls vote.

        Nobody knows the roles in this
        basic random-voting model.
        */


        const voteCounts =
            new Map();


        for (const player of players) {

            voteCounts.set(
                player,
                0
            );

        }


        for (const voter of players) {

            /*
            A player cannot vote for themselves.
            */

            const choices =
                players.filter(
                    player =>
                        player !== voter
                );


            const target =
                randomElement(
                    choices
                );


            voteCounts.set(
                target,
                voteCounts.get(target) + 1
            );

        }


        /*
        Find highest number of votes.
        */

        const highestVotes =
            Math.max(
                ...voteCounts.values()
            );


        /*
        Players tied for highest votes.
        */

        const candidates =
            [...voteCounts.entries()]
                .filter(
                    entry =>
                        entry[1] === highestVotes
                )
                .map(
                    entry =>
                        entry[0]
                );


        /*
        Random tie breaker.
        */

        const eliminated =
            randomElement(
                candidates
            );


        /*
        Remove voting elimination.
        */

        players =
            players.filter(
                player =>
                    player !== eliminated
            );


        /*
        If the eliminated player
        was a traitor, remove them.
        */

        traitors.delete(
            eliminated
        );


        /*
        ==================================================
        2. RECRUITMENT
        ==================================================
        */


        if (
            traitors.size === 2 &&
            !recruitmentUsed
        ) {

            const faithfuls =
                players.filter(
                    player =>
                        !traitors.has(player)
                );


            if (faithfuls.length > 0) {

                const recruit =
                    randomElement(
                        faithfuls
                    );


                traitors.add(
                    recruit
                );


                recruitmentUsed = true;

            }

        }


        /*
        ==================================================
        3. MURDER
        ==================================================

        ONLY TRAITORS choose the victim.

        The victim must be faithful.
        */


        if (traitors.size > 0) {

            const faithfuls =
                players.filter(
                    player =>
                        !traitors.has(player)
                );


            if (faithfuls.length > 0) {

                const victim =
                    randomElement(
                        faithfuls
                    );


                players =
                    players.filter(
                        player =>
                            player !== victim
                    );

            }

        }


        /*
        If all traitors have been eliminated,
        faithfuls have won.
        */

        if (traitors.size === 0) {

            return {

                winner: "faithful",

                rounds: normalRounds

            };

        }

    }


    /*
    ======================================================
    FINAL VOTING
    ======================================================

    Three players remain.

    They vote against each other.

    Then two remain.

    They vote again.

    One player survives.
    */


    while (players.length > 1) {


        const voteCounts =
            new Map();


        for (const player of players) {

            voteCounts.set(
                player,
                0
            );

        }


        /*
        Everyone votes.
        */

        for (const voter of players) {

            const choices =
                players.filter(
                    player =>
                        player !== voter
                );


            const target =
                randomElement(
                    choices
                );


            voteCounts.set(
                target,
                voteCounts.get(target) + 1
            );

        }


        const highestVotes =
            Math.max(
                ...voteCounts.values()
            );


        const candidates =
            [...voteCounts.entries()]
                .filter(
                    entry =>
                        entry[1] === highestVotes
                )
                .map(
                    entry =>
                        entry[0]
                );


        const eliminated =
            randomElement(
                candidates
            );


        players =
            players.filter(
                player =>
                    player !== eliminated
            );

    }


    /*
    ======================================================
    FINAL SURVIVOR
    ======================================================
    */


    const survivor =
        players[0];


    if (
        traitors.has(survivor)
    ) {

        return {

            winner: "traitor",

            rounds: normalRounds

        };

    }


    return {

        winner: "faithful",

        rounds: normalRounds

    };

}


/*
----------------------------------------------------------
RUN BATCH
----------------------------------------------------------
*/


async function runSimulations(
    numberOfSimulations
) {


    if (isRunning) {

        return;

    }


    isRunning = true;

    stopRequested = false;


    const runButton =
        document.getElementById(
            "runButton"
        );


    const stopButton =
        document.getElementById(
            "stopButton"
        );


    const progressBar =
        document.getElementById(
            "progressBar"
        );


    const status =
        document.getElementById(
            "status"
        );


    runButton.disabled = true;

    stopButton.disabled = false;


    document.getElementById(
        "resultsCard"
    ).style.display = "none";


    let traitorWins = 0;

    let faithfulWins = 0;

    let totalRounds = 0;

    let shortestGame =
        Infinity;

    let longestGame = 0;


    const startTime =
        performance.now();


    /*
    Run simulations in batches.

    This prevents the browser UI
    from freezing.
    */


    const batchSize = 1000;


    for (
        let start = 0;

        start < numberOfSimulations;

        start += batchSize
    ) {


        if (stopRequested) {

            break;

        }


        const end =
            Math.min(
                start + batchSize,
                numberOfSimulations
            );


        for (
            let i = start;

            i < end;

            i++
        ) {


            const result =
                simulateGame();


            if (
                result.winner ===
                "traitor"
            ) {

                traitorWins++;

            }

            else {

                faithfulWins++;

            }


            totalRounds +=
                result.rounds;


            shortestGame =
                Math.min(
                    shortestGame,
                    result.rounds
                );


            longestGame =
                Math.max(
                    longestGame,
                    result.rounds
                );

        }


        /*
        Update progress.
        */


        const completed =
            end;


        const percentage =
            (
                completed /
                numberOfSimulations
            ) * 100;


        progressBar.style.width =
            percentage + "%";


        status.textContent =
            "Running: " +
            completed.toLocaleString() +
            " / " +
            numberOfSimulations.toLocaleString() +
            " (" +
            percentage.toFixed(1) +
            "%)";


        /*
        Allow Safari to update
        the screen.
        */

        await new Promise(
            resolve =>
                setTimeout(
                    resolve,
                    0
                )
        );

    }


    const completedNormally =
        !stopRequested;


    const actualSimulations =
        traitorWins +
        faithfulWins;


    const elapsed =
        (
            performance.now() -
            startTime
        ) / 1000;


    if (
        actualSimulations > 0
    ) {


        const traitorPercentage =
            (
                traitorWins /
                actualSimulations
            ) * 100;


        const faithfulPercentage =
            (
                faithfulWins /
                actualSimulations
            ) * 100;


        const averageRounds =
            totalRounds /
            actualSimulations;


        /*
        DISPLAY RESULTS
        */


        document.getElementById(
            "traitorWins"
        ).textContent =
            traitorWins.toLocaleString();


        document.getElementById(
            "faithfulWins"
        ).textContent =
            faithfulWins.toLocaleString();


        document.getElementById(
            "traitorPercentage"
        ).textContent =
            traitorPercentage.toFixed(4) +
            "%";


        document.getElementById(
            "faithfulPercentage"
        ).textContent =
            faithfulPercentage.toFixed(4) +
            "%";


        document.getElementById(
            "averageRounds"
        ).textContent =
            averageRounds.toFixed(2);


        document.getElementById(
            "shortestGame"
        ).textContent =
            shortestGame;


        document.getElementById(
            "longestGame"
        ).textContent =
            longestGame;


        document.getElementById(
            "totalSimulations"
        ).textContent =
            actualSimulations.toLocaleString();


        document.getElementById(
            "resultsCard"
        ).style.display =
            "block";


        if (completedNormally) {

            status.textContent =
                "Completed " +
                actualSimulations.toLocaleString() +
                " simulations in " +
                elapsed.toFixed(2) +
                " seconds.";

        }

        else {

            status.textContent =
                "Stopped after " +
                actualSimulations.toLocaleString() +
                " simulations.";

        }

    }


    isRunning = false;

    runButton.disabled = false;

    stopButton.disabled = true;

}


/*
----------------------------------------------------------
BUTTON EVENTS
----------------------------------------------------------
*/


document
    .getElementById("runButton")
    .addEventListener(
        "click",
        () => {


            const input =
                document.getElementById(
                    "simulationCount"
                );


            const number =
                Number(
                    input.value
                );


            if (
                !Number.isInteger(number) ||
                number < 1 ||
                number > 10000000
            ) {

                alert(
                    "Please enter a number between 1 and 10,000,000."
                );

                return;

            }


            runSimulations(
                number
            );

        }
    );


/*
STOP BUTTON
*/


document
    .getElementById("stopButton")
    .addEventListener(
        "click",
        () => {

            stopRequested = true;

        }
    );

</script>

</body>
</html>